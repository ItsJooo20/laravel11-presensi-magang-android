<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/navy" /> <!-- Warna background -->
            <corners android:radius="12dp" /> <!-- Radius sudut -->
            <size android:height="24dp" /> <!-- Tinggi background -->
        </shape>
    </item>

    <!-- Saat item tidak dipilih -->
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" /> <!-- Transparan -->
        </shape>
    </item>
</selector>